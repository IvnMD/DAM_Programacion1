    void desmatricularAsignaturaEliminaRelacion() {
        service.matricularAsignatura("ALM001", "PROG");
        assertTrue(service.desmatricularAsignatura("ALM001", "PROG"));
        assertFalse(service.estaMatriculadoEn("ALM001", "PROG"));
