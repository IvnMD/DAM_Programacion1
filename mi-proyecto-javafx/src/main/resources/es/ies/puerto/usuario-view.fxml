<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" styleClass="contenedor" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.ies.puerto.controllers.UsuarioController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="titulo" text="Crear usuario" />

    <TextField fx:id="nombreField" promptText="Nombre" />
    <TextField fx:id="edadField" promptText="Edad" />

    <Button onAction="#mostrarUsuario" text="Mostrar usuario" />
   <Button mnemonicParsing="false" onAction="#deleteUsuario" prefHeight="26.0" prefWidth="160.0" text="Eliminar usuario" />
    <ListView fx:id="usuariosListView" prefHeight="180" />
    <Label fx:id="resultadoLabel" text="Resultado" />



</VBox>
