        return new Venta(
            rs.getInt("id"),
            rs.getString("fecha"),
            rs.getString("ticket"),
            rs.getString("dni_cliente"),
            rs.getString("metodo_pago"),
            rs.getDouble("subtotal"),
            rs.getDouble("descuento_total"),
